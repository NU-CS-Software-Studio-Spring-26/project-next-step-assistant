# Copy to .env for local development (never commit .env).

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL (local): http://localhost:3000/users/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: OpenAI features (job import, AI suggestions)
OPENAI_API_KEY=

# Mailer (production/Heroku) — password reset emails
# MAILER_HOST=next-step-assistant-a4dab79f7e69.herokuapp.com
# MAILER_FROM=noreply@your-verified-sender.com
# SENDGRID_API_KEY=your_sendgrid_api_key
