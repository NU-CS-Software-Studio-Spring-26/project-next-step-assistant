<%= form_with(model: job, multipart: true, data: { controller: "job-form-fields" }) do |form| %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
      <% if job.errors.any? %>
        <div class="alert alert-danger mb-4" role="alert">
          <p class="fw-semibold mb-2"><%= pluralize(job.errors.count, "error") %> prohibited this job from being saved:</p>
          <ul class="mb-0 ps-3">
            <% job.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3">
        <div class="col-12 col-md-7">
          <%= form.label :title, "Job title", class: "form-label" %>
          <%= form.text_field :title, class: "form-control", placeholder: "e.g. Software Engineer Intern", maxlength: Job::TITLE_MAX_LENGTH %>
        </div>

        <div class="col-12 col-md-5">
          <%= form.label :organization_name, "Organization", class: "form-label" %>
          <%= form.text_field :organization_name, class: "form-control", placeholder: "Company or program", maxlength: Job::ORGANIZATION_NAME_MAX_LENGTH %>
        </div>

        <div class="col-12 col-md-4">
          <%= form.label :status, class: "form-label" %>
          <%= form.select :status, job_status_options, { include_blank: "Select status" }, { class: "form-select", data: { job_form_fields_target: "status", action: "change->job-form-fields#toggle" } } %>
        </div>

        <div class="col-6 col-md-4" data-job-form-fields-target="deadline">
          <%= form.label :deadline, class: "form-label" %>
          <%= form.date_field :deadline, class: "form-control" %>
        </div>

        <div class="col-6 col-md-4">
          <%= form.label :start_date, "Start date", class: "form-label" %>
          <%= form.date_field :start_date, class: "form-control" %>
        </div>

        <div class="col-12 col-md-8">
          <%= render "resume_select", form: form %>
          <details class="mt-2">
            <summary class="small link-primary" style="cursor: pointer;">
              <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Upload a new resume
            </summary>
            <div class="row g-2 mt-1 p-3 bg-body-tertiary rounded">
              <div class="col-12 col-md-6">
                <%= form.label :new_resume_name, "Resume name", class: "form-label small" %>
                <%= form.text_field :new_resume_name, class: "form-control form-control-sm", placeholder: "e.g. SWE-focused", maxlength: Resume::NAME_MAX_LENGTH %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :new_resume_file, "PDF file", class: "form-label small" %>
                <%= form.file_field :new_resume_file, class: "form-control form-control-sm", accept: "application/pdf" %>
              </div>
              <div class="col-12">
                <p class="small text-body-secondary mb-0">PDF only, max <%= Resume::FILE_MAX_SIZE / 1.megabyte %> MB. Uploading here saves the resume to your library and selects it for this job.</p>
              </div>
            </div>
          </details>
        </div>

        <div class="col-12" data-controller="character-counter">
          <%= form.label :description, class: "form-label" %>
          <%= form.textarea :description, rows: 6, class: "form-control", placeholder: "Notes, links, requirements, contacts…", maxlength: Job::DESCRIPTION_MAX_LENGTH, data: { character_counter_target: "input", action: "input->character-counter#update" } %>
          <small class="char-counter" data-character-counter-target="counter" aria-live="polite"></small>
        </div>
      </div>

      <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mt-4 pt-3 border-top">
        <%= link_to "Back to Jobs", jobs_path, class: "btn btn-outline-secondary" %>
        <%= form.submit "Save Job", class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
      </div>
    </div>
  </div>
<% end %>
