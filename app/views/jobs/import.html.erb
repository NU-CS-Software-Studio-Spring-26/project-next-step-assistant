<% content_for :title, "Import job" %>

<div class="container py-4 py-lg-5">
  <div class="mb-4">
    <%= link_to "Back to Jobs", jobs_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <header class="mb-4 pb-2 border-bottom">
    <h1 class="h2 mb-1 fw-semibold">
      <i class="bi bi-box-arrow-in-down me-2" aria-hidden="true"></i>Import a job
    </h1>
    <p class="text-body-secondary mb-0 small">
      Import from a Greenhouse listing or paste posting text. You will review fields before saving.
    </p>
  </header>

  <section class="mb-4" aria-labelledby="greenhouse-import-heading">
    <h2 id="greenhouse-import-heading" class="h5 fw-semibold mb-2">
      <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>Import from Greenhouse
    </h2>
    <p class="small text-body-secondary mb-3">
      Paste a public job URL from <code>boards.greenhouse.io</code>. We fetch the listing via Greenhouse&apos;s API—no OpenAI key required.
    </p>

    <%= form_with url: import_greenhouse_jobs_path, method: :post, local: true, class: "card shadow-sm border-0" do %>
      <div class="card-body p-3 p-md-4">
        <div class="mb-3">
          <%= label_tag :greenhouse_url, "Greenhouse job URL", class: "form-label fw-semibold" %>
          <%= url_field_tag :greenhouse_url,
                @greenhouse_url,
                class: "form-control",
                placeholder: "https://boards.greenhouse.io/company/jobs/123456",
                autocomplete: "url",
                required: true %>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <%= submit_tag "Import from Greenhouse", class: "btn btn-primary", data: { turbo_submits_with: "Importing…" } %>
          <%= link_to "Cancel", jobs_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="ai-import-heading">
    <h2 id="ai-import-heading" class="h5 fw-semibold mb-2">
      <i class="bi bi-clipboard-plus me-1" aria-hidden="true"></i>Quick import from pasted text
    </h2>
    <p class="small text-body-secondary mb-3">
      Paste the full job posting text. AI extracts title, organization, dates, and description when configured.
    </p>

    <% unless openai_configured? %>
      <%= render "shared/empty_state",
          icon: "bi-key",
          heading: "AI import is currently offline",
          body: "The OpenAI API key has not been configured for this environment." %>
    <% else %>
      <% if @result && @result.state != :ready %>
        <div class="alert alert-warning mb-3" role="alert"><%= @result.message %></div>
      <% end %>

      <%= form_with url: import_jobs_path, method: :post, local: true, class: "card shadow-sm border-0" do %>
        <div class="card-body p-3 p-md-4">
          <div data-controller="character-counter">
            <%= label_tag :job_text, "Paste the job posting", class: "form-label fw-semibold" %>
            <%= text_area_tag :job_text,
                              @job_text,
                              rows: 12,
                              maxlength: JobImportService::MAX_INPUT_CHARS,
                              class: "form-control font-monospace",
                              placeholder: "Paste the full job description here…",
                              data: { character_counter_target: "input", action: "input->character-counter#update" } %>
            <small class="char-counter" data-character-counter-target="counter" aria-live="polite"></small>
          </div>
          <p class="small text-body-secondary mt-2 mb-3">
            Tip: select all on the job posting page (Cmd-A / Ctrl-A), copy, and paste here. You will review the result before saving.
          </p>
          <div class="d-flex flex-wrap gap-2">
            <%= submit_tag "Extract fields", class: "btn btn-outline-primary", data: { turbo_submits_with: "Extracting…" } %>
            <%= link_to "Cancel", jobs_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
