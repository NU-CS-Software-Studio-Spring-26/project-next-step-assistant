<% content_for :title, "Jobs" %>

<div class="container py-4 py-lg-5">
  <div class="mb-4">
    <%= link_to "Home", root_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <header class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 pb-2 border-bottom">
    <div>
      <h1 class="h2 mb-1 fw-semibold">Jobs</h1>
      <p class="text-body-secondary mb-0 small">Track every application from saved through offer.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to resumes_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Manage Resumes
      <% end %>
      <%= link_to import_jobs_path, class: "btn btn-outline-primary" do %>
        <i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i>Import
      <% end %>
      <%= link_to new_job_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New Job
      <% end %>
    </div>
  </header>

  <%= turbo_frame_tag "jobs_list", aria: { label: "Job search and results" } do %>
    <div class="mb-4">
      <%= form_with url: jobs_path, method: :get, class: "row g-2 g-sm-3 align-items-end", data: { turbo_action: "advance" } do %>
        <% if @status.present? %>
          <%= hidden_field_tag :status, @status %>
        <% end %>
        <div class="col-12 col-sm">
          <label for="jobs_search_query" class="form-label small text-body-secondary mb-1">Search</label>
          <%= text_field_tag :query, params[:query], class: "form-control", id: "jobs_search_query", placeholder: "Title or organization…", autocomplete: "off", maxlength: JobsController::SEARCH_QUERY_MAX_LENGTH, data: { controller: "search-debounce", action: "input->search-debounce#schedule" } %>
        </div>
        <div class="col-12 col-sm-auto">
          <label class="form-label small text-body-secondary mb-1 d-none d-sm-block">&nbsp;</label>
          <div class="d-flex flex-wrap gap-2">
            <%= button_tag type: "submit", class: "btn btn-primary w-100 w-sm-auto", data: { turbo_submits_with: "Searching…" } do %>
              <i class="bi bi-search me-1" aria-hidden="true"></i>Search
            <% end %>
            <% if @query.present? %>
              <%= link_to "Clear", jobs_path(status: @status.presence), class: "btn btn-outline-secondary w-100 w-sm-auto" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% jobs_filter_path = lambda do |status: nil|
         p = {}
         p[:query] = @query if @query.present?
         p[:status] = status if status.present?
         jobs_path(p)
       end %>
    <div class="mb-4">
      <h2 class="h6 small text-body-secondary mb-2">Status</h2>
      <nav class="d-flex flex-wrap gap-2 align-items-center" aria-label="Filter jobs by status">
        <%= link_to "All", jobs_filter_path.call, class: "btn btn-sm #{@status.blank? ? "btn-primary" : "btn-outline-primary"}", **(@status.blank? ? { aria: { current: "page" } } : {}), data: { turbo_action: "advance" } %>
        <% Job.statuses.each_key do |status_key| %>
          <%= link_to job_status_label(status_key), jobs_filter_path.call(status: status_key), class: "btn btn-sm #{@status == status_key.to_s ? "btn-primary" : "btn-outline-primary"}", **(@status == status_key.to_s ? { aria: { current: "page" } } : {}), data: { turbo_action: "advance" } %>
        <% end %>
      </nav>
    </div>

    <%= render "jobs/list" %>
  <% end %>
</div>
