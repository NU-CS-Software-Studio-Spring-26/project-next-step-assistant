<% if @jobs.any? %>
  <div id="jobs" class="vstack gap-3">
    <% @jobs.each do |job| %>
      <%= render job %>
    <% end %>
  </div>
<% elsif @query.present? || @status.present? %>
  <%= render "shared/empty_state",
      icon: "bi-search",
      heading: "No matching jobs",
      body: "Nothing matched your current search or status filter.",
      cta_text: "Clear all filters",
      cta_path: jobs_path,
      cta_icon: "bi-arrow-counterclockwise" %>
<% else %>
  <%= render "shared/empty_state",
      icon: "bi-briefcase",
      heading: "No jobs yet",
      body: "Add your first opening to start tracking applications and deadlines.",
      cta_text: "Add a Job",
      cta_path: new_job_path,
      cta_icon: "bi-plus-lg" %>
<% end %>

<% if defined?(@pagy) && @pagy.pages > 1 %>
  <div class="mt-4 d-flex justify-content-center">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
