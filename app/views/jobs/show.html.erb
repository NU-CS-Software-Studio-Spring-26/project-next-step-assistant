<% content_for :title, @job.title.presence || "Job" %>

<div class="container py-4 py-lg-5">
  <div class="mb-4">
    <%= link_to "Back to Jobs", jobs_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3 mb-4 pb-3 border-bottom">
        <div>
          <h1 class="h2 mb-1 fw-semibold"><%= @job.title.presence || "Untitled role" %></h1>
          <% if @job.organization_name.present? %>
            <p class="text-body-secondary mb-0"><%= @job.organization_name %></p>
          <% end %>
        </div>
        <% if @job.status.present? %>
          <%= job_status_badge_dropdown(@job, extra_classes: "fs-6") %>
        <% end %>
      </div>

      <dl class="row mb-0 gy-3">
        <dt class="col-sm-3 text-body-secondary small text-uppercase fw-semibold">Deadline</dt>
        <dd class="col-sm-9 mb-0">
          <% if @job.deadline.present? %>
            <%= @job.deadline.to_fs(:long) %>
          <% else %>
            <span class="text-body-secondary">—</span>
          <% end %>
        </dd>

        <dt class="col-sm-3 text-body-secondary small text-uppercase fw-semibold">Start date</dt>
        <dd class="col-sm-9 mb-0">
          <% if @job.start_date.present? %>
            <%= @job.start_date.to_fs(:long) %>
          <% else %>
            <span class="text-body-secondary">—</span>
          <% end %>
        </dd>

        <dt class="col-sm-3 text-body-secondary small text-uppercase fw-semibold">Description</dt>
        <dd class="col-sm-9 mb-0">
          <% if @job.description.present? %>
            <div class="collapsible" data-controller="collapsible">
              <div class="collapsible__content text-body lh-base" data-collapsible-target="content">
                <%= simple_format(@job.description) %>
              </div>
              <button
                type="button"
                class="btn btn-link btn-sm collapsible__toggle mt-2"
                data-action="click->collapsible#toggle"
                data-collapsible-target="toggle"
                aria-expanded="false">
                <span data-collapsible-target="moreLabel">
                  <i class="bi bi-chevron-down me-1" aria-hidden="true"></i>Show more
                </span>
                <span data-collapsible-target="lessLabel" hidden>
                  <i class="bi bi-chevron-up me-1" aria-hidden="true"></i>Show less
                </span>
              </button>
            </div>
          <% else %>
            <span class="text-body-secondary">—</span>
          <% end %>
        </dd>

        <dt class="col-sm-3 text-body-secondary small text-uppercase fw-semibold">Selected resume</dt>
        <dd class="col-sm-9 mb-0">
          <% if @job.resume&.file&.attached? %>
            <%= link_to download_resume_path(@job.resume), class: "btn btn-sm btn-outline-primary", data: { turbo: false } do %>
              <i class="bi bi-download me-1" aria-hidden="true"></i>Download Resume
            <% end %>
          <% else %>
            <span class="text-body-secondary">—</span>
          <% end %>
        </dd>
      </dl>

      <%= render "jobs/match_assistant", match: @job_match %>

      <section class="mt-4 pt-4 border-top" aria-labelledby="job-resume-section-heading">
        <h2 id="job-resume-section-heading" class="h6 text-body-secondary text-uppercase fw-semibold mb-3">Resume</h2>
        <%= form_with model: @job, class: "card bg-body-tertiary border-0" do |form| %>
          <%= hidden_field_tag :from_show, "1" %>
          <div class="card-body p-3">
            <% if @job.errors.any? %>
              <div class="alert alert-danger mb-3" role="alert">
                <ul class="mb-0 small ps-3">
                  <% @job.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <div class="row g-2 align-items-end">
              <div class="col-sm-8">
                <%= render "resume_select", form: form %>
              </div>
              <div class="col-sm-4">
                <%= form.button type: "submit", class: "btn btn-primary w-100", data: { turbo_submits_with: "Updating…" } do %>
                  <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Update resume
                <% end %>
              </div>
            </div>
            <p class="small text-body-secondary mb-0 mt-2">
              Choose from your <%= link_to "resume library", resumes_path, class: "link-primary" %>.
              <%= link_to "Upload a new resume", new_resume_path, class: "link-primary" %> if needed.
            </p>
          </div>
        <% end %>
      </section>

      <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 mt-4 pt-4 border-top">
        <%= link_to edit_job_path(@job), class: "btn btn-primary" do %>
          <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit Job
        <% end %>
        <% if openai_configured? %>
          <%= link_to ai_suggestions_projects_path(job_ids: [ @job.id ], generate: "1"), class: "btn btn-outline-primary" do %>
            <i class="bi bi-stars me-1" aria-hidden="true"></i>Get project ideas for this job
          <% end %>
          <% if @job.description.present? && @job.resume&.file&.attached? %>
            <%= link_to ai_resume_suggestions_job_path(@job), class: "btn btn-outline-primary" do %>
              <i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Get resume suggestions
            <% end %>
          <% end %>
        <% end %>
        <%= link_to "Back to Jobs", jobs_path, class: "btn btn-outline-secondary" %>
        <%= button_to @job, method: :delete, class: "btn btn-outline-danger", form: { class: "d-inline", data: { turbo_confirm: "Delete this job? This cannot be undone." } } do %>
          <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete Job
        <% end %>
      </div>
    </div>
  </div>
</div>
