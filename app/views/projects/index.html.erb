<% content_for :title, "Projects" %>

<div class="container py-4 py-lg-5">
  <div class="mb-4">
    <%= link_to "Home", root_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <header class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 pb-2 border-bottom">
    <h1 class="h2 mb-0 fw-semibold">Projects</h1>
    <div class="d-flex flex-wrap gap-2">
      <% if openai_configured? %>
        <%= link_to ai_suggestions_projects_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-stars me-1" aria-hidden="true"></i>Get AI project ideas
        <% end %>
      <% end %>
      <%= link_to new_project_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New Project
      <% end %>
    </div>
  </header>

  <div class="mb-4">
    <%= form_with url: projects_path, method: :get, class: "row g-2 g-sm-3 align-items-end", data: { turbo_action: "advance" } do %>
      <div class="col-12 col-sm">
        <label for="projects_search_query" class="form-label small text-body-secondary mb-1">Search</label>
        <%= text_field_tag :query, params[:query], class: "form-control", id: "projects_search_query", placeholder: "Name or skills…", autocomplete: "off", maxlength: ProjectsController::SEARCH_QUERY_MAX_LENGTH, data: { controller: "search-debounce", action: "input->search-debounce#schedule" } %>
      </div>
      <div class="col-12 col-sm-auto">
        <label class="form-label small text-body-secondary mb-1 d-none d-sm-block">&nbsp;</label>
        <div class="d-flex flex-wrap gap-2">
          <%= button_tag type: "submit", class: "btn btn-primary w-100 w-sm-auto", data: { turbo_submits_with: "Searching…" } do %>
            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
          <% end %>
          <% if @query.present? %>
            <%= link_to "Clear", projects_path, class: "btn btn-outline-secondary w-100 w-sm-auto" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @projects.any? %>
    <div id="projects" class="vstack gap-3">
      <% @projects.each do |project| %>
        <%= render project %>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <%= render "shared/empty_state",
        icon: "bi-search",
        heading: "No matching projects",
        body: "Nothing matched “#{@query}”. Try different keywords.",
        cta_text: "View all projects",
        cta_path: projects_path,
        cta_icon: "bi-arrow-counterclockwise" %>
  <% else %>
    <%= render "shared/empty_state",
        icon: "bi-kanban",
        heading: "No projects yet",
        body: "Add a portfolio project to showcase your work in applications.",
        cta_text: "New Project",
        cta_path: new_project_path,
        cta_icon: "bi-plus-lg" %>
  <% end %>
  <% if defined?(@pagy) && @pagy.pages > 1 %>
    <div class="mt-4 d-flex justify-content-center">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
</div>
