<%#
  Locals:
    icon:       Bootstrap Icons class, e.g. "bi-briefcase" (required)
    heading:    Headline text (required)
    body:       Body text (optional)
    cta_text:   Primary button label (optional)
    cta_path:   Primary button URL (optional, required if cta_text given)
    cta_icon:   Icon for primary button (optional)
    secondary_cta_text: Secondary link label (optional)
    secondary_cta_path: Secondary link URL (optional)
%>
<div class="card shadow-sm border-0 empty-state">
  <div class="card-body p-4 p-lg-5 text-center">
    <div class="empty-state__icon mb-3" aria-hidden="true">
      <i class="bi <%= local_assigns.fetch(:icon, "bi-inbox") %>"></i>
    </div>
    <h2 class="h5 fw-semibold mb-2"><%= heading %></h2>
    <% if local_assigns[:body].present? %>
      <p class="empty-state__body mb-4"><%= body %></p>
    <% end %>

    <% if local_assigns[:cta_text].present? && local_assigns[:cta_path].present? %>
      <%= link_to cta_path, class: "btn btn-primary" do %>
        <% if local_assigns[:cta_icon].present? %>
          <i class="bi <%= cta_icon %> me-1" aria-hidden="true"></i>
        <% end %>
        <%= cta_text %>
      <% end %>
    <% end %>

    <% if local_assigns[:secondary_cta_text].present? && local_assigns[:secondary_cta_path].present? %>
      <div class="mt-3">
        <%= link_to secondary_cta_text, secondary_cta_path, class: "link-primary" %>
      </div>
    <% end %>
  </div>
</div>
