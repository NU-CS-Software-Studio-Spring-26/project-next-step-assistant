<% content_for :title, @resume.name.presence || "Resume" %>

<div class="container py-4 py-lg-5">
  <div class="mb-4 d-flex flex-wrap gap-2">
    <%= link_to "Back to Resume Library", resumes_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to edit_resume_path(@resume), class: "btn btn-outline-primary btn-sm" do %>
      <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
    <% end %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
      <h1 class="h3 fw-semibold mb-3"><%= @resume.name %></h1>

      <p class="text-body-secondary mb-4">
        Used by <%= pluralize(@resume.jobs.size, "job") %>
      </p>

      <dl class="row mb-4 gy-3">
        <dt class="col-sm-4 text-body-secondary small text-uppercase fw-semibold">File name</dt>
        <dd class="col-sm-8 mb-0">
          <% if @resume.file.attached? %>
            <%= @resume.file.filename %>
          <% else %>
            <span class="text-body-secondary">No file attached</span>
          <% end %>
        </dd>

        <dt class="col-sm-4 text-body-secondary small text-uppercase fw-semibold">Upload date</dt>
        <dd class="col-sm-8 mb-0"><%= l(@resume.created_at.to_date, format: :long) %></dd>
      </dl>

      <% if @resume.file.attached? %>
        <section class="mb-4" aria-labelledby="resume-preview-heading">
          <h2 id="resume-preview-heading" class="h6 text-body-secondary text-uppercase fw-semibold mb-3">Preview</h2>
          <div class="border rounded overflow-hidden bg-body-tertiary">
            <iframe
              src="<%= preview_resume_path(@resume) %>"
              title="PDF preview of <%= @resume.name %>"
              class="w-100 border-0"
              style="min-height: 70vh;"
            ></iframe>
          </div>
        </section>

        <%= link_to download_resume_path(@resume), class: "btn btn-primary", data: { turbo: false } do %>
          <i class="bi bi-download me-1" aria-hidden="true"></i>Download Resume
        <% end %>
      <% end %>
    </div>
  </div>
</div>
